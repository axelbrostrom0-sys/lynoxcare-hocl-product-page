{%- comment -%}
  Renders 5 filled stars in the verified-blue accent color.
  Usage: {% render 'stars', rating: '4,9' %}
{%- endcomment -%}
<span class="stars" aria-label="{{ rating | default: '4,9' }} av 5 stjärnor">
  {%- for i in (1..5) -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
  {%- endfor -%}
</span>
