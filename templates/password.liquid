<h1 style="font-size:28px;margin-bottom:16px;">Snart öppnar vi</h1>
<p class="rte" style="margin-bottom:24px;">Ange lösenordet för att komma in i butiken.</p>

{%- form 'storefront_password' -%}
  {%- if form.errors -%}
    <p class="field-help" style="color:#c0392b;">{{ form.errors.messages.password }}</p>
  {%- endif -%}
  <div class="form-row" style="max-width:320px;margin:0 auto 16px;">
    <label for="pw">Lösenord</label>
    <input type="password" id="pw" name="password" autocomplete="current-password">
  </div>
  <button type="submit" class="btn" style="max-width:320px;margin:0 auto;">Kom in</button>
{%- endform -%}
