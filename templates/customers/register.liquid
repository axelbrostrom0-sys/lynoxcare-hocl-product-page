<div class="page-narrow">
  <h1>Skapa konto</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div class="form-row">
      <label for="first">Förnamn</label>
      <input type="text" id="first" name="customer[first_name]" autocomplete="given-name">
    </div>
    <div class="form-row">
      <label for="last">Efternamn</label>
      <input type="text" id="last" name="customer[last_name]" autocomplete="family-name">
    </div>
    <div class="form-row">
      <label for="email">E-post</label>
      <input type="email" id="email" name="customer[email]" autocomplete="email">
    </div>
    <div class="form-row">
      <label for="password">Lösenord</label>
      <input type="password" id="password" name="customer[password]" autocomplete="new-password">
    </div>
    <button type="submit" class="btn" style="max-width:240px;">Skapa konto</button>
  {%- endform -%}
</div>
