<div class="page-narrow">
  <h1>Aktivera ditt konto</h1>
  <p class="rte" style="margin-bottom:24px;">Skapa ett lösenord för att aktivera kontot.</p>
  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="form-row">
      <label for="password">Lösenord</label>
      <input type="password" id="password" name="customer[password]" autocomplete="new-password">
    </div>
    <div class="form-row">
      <label for="password_confirmation">Bekräfta lösenord</label>
      <input type="password" id="password_confirmation" name="customer[password_confirmation]" autocomplete="new-password">
    </div>
    <button type="submit" class="btn" style="max-width:240px;">Aktivera konto</button>
    <button type="submit" name="decline" class="btn btn-outline" style="max-width:240px;margin-top:10px;">Avböj inbjudan</button>
  {%- endform -%}
</div>
