<div class="page-narrow">
  <h1>Återställ lösenord</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="form-row">
      <label for="password">Nytt lösenord</label>
      <input type="password" id="password" name="customer[password]" autocomplete="new-password">
    </div>
    <div class="form-row">
      <label for="password_confirmation">Bekräfta lösenord</label>
      <input type="password" id="password_confirmation" name="customer[password_confirmation]" autocomplete="new-password">
    </div>
    <button type="submit" class="btn" style="max-width:240px;">Återställ</button>
  {%- endform -%}
</div>
