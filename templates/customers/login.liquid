<div class="page-narrow">
  <h1>Logga in</h1>
  {%- form 'customer_login' -%}
    {{ form.errors | default_errors }}
    <div class="form-row">
      <label for="email">E-post</label>
      <input type="email" id="email" name="customer[email]" autocomplete="email">
    </div>
    <div class="form-row">
      <label for="password">Lösenord</label>
      <input type="password" id="password" name="customer[password]" autocomplete="current-password">
    </div>
    <button type="submit" class="btn" style="max-width:240px;">Logga in</button>
  {%- endform -%}
  <p class="field-help" style="margin-top:20px;">
    Ny här? <a href="{{ routes.account_register_url }}" style="color:var(--blue);">Skapa konto</a>
  </p>
</div>
