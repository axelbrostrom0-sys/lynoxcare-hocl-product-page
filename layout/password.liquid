<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  {%- style -%}
    :root{
      --bg: {{ settings.color_bg | default: '#FFFFFF' }};
      --text: {{ settings.color_text | default: '#141414' }};
      --muted: {{ settings.color_muted | default: '#6E6E6E' }};
      --line: {{ settings.color_line | default: '#E7E4DF' }};
      --accent: {{ settings.color_accent | default: '#141414' }};
      --cream: {{ settings.color_cream | default: '#F3EEE8' }};
      --blue: {{ settings.color_blue | default: '#2D9CDB' }};
      --radius: 16px;
      --maxw: 1120px;
    }
  {%- endstyle -%}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <div class="announce">Fri frakt &middot; 30 dagars öppet köp</div>
  <main class="page-narrow" style="text-align:center;">
    <div class="brand" style="margin-bottom:24px;">{{ shop.name | default: 'LYNOXCARE' }}</div>
    {{ content_for_layout }}
  </main>
</body>
</html>
