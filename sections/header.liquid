<header class="site-header">
  <div class="wrap">
    <div class="nav">
      <nav class="nav-left">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- else -%}
          <a href="{{ routes.root_url }}#mekanism">Om HOCl</a>
          <a href="{{ routes.root_url }}#recensioner">Recensioner</a>
          <a href="{{ routes.root_url }}#trygghet">Trygghet</a>
        {%- endfor -%}
      </nav>

      <a class="brand" href="{{ routes.root_url }}">
        {{ section.settings.wordmark | default: 'LYNOXCARE' }}
      </a>

      <div class="nav-right">
        <a class="cart" href="{{ routes.cart_url }}" aria-label="Varukorg">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span>{{ cart.item_count | default: 0 }}</span>
        </a>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Sidhuvud",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Ordmärke",
      "default": "LYNOXCARE"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Meny"
    }
  ]
}
{% endschema %}
