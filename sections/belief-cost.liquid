<section class="block belief cream">
  <div class="wrap narrow">
    <h2>{{ section.settings.heading }}</h2>
    <p class="lead">{{ section.settings.lead }}</p>
    <p>{{ section.settings.body1 }}</p>
    <p>{{ section.settings.body2 }}</p>
    <div class="cta-after">
      <a class="btn btn-lg" href="{{ section.settings.cta_url | default: 'https://www.lynoxcare.store/products/skin-revival-spray' }}">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Belief: kostnad",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Räkna på vad huden redan kostar dig." },
    { "type": "textarea", "id": "lead", "label": "Ingress", "default": "Inte i kronor. I allt annat." },
    { "type": "textarea", "id": "body1", "label": "Brödtext 1", "default": "Foundationen varje morgon du hellre hoppat över. Bilderna du ställer dig bakom istället för i. Rodnaden efter gymmet. Spegeln du checkar för femte gången. Kvällen du ställde in. Dagsljuset du undviker." },
    { "type": "textarea", "id": "body2", "label": "Brödtext 2", "default": "Frågan är inte om det är värt en flaska. Frågan är vad ännu ett år så här kostar dig." },
    { "type": "text", "id": "cta_label", "label": "Knapptext", "default": "Testa i 30 dagar" },
    { "type": "url", "id": "cta_url", "label": "Knapplänk", "default": "https://www.lynoxcare.store/products/skin-revival-spray" }
  ],
  "presets": [ { "name": "Belief: kostnad" } ]
}
{% endschema %}
