<section class="block cream" id="mekanism">
  <div class="wrap">
    <div class="two-col">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" width="900" height="675" style="border-radius:var(--radius);" loading="lazy">
      {%- else -%}
        <div class="ph" style="aspect-ratio:4/3;">
          <span class="ph-title">Hypoklorsyra-molekylen, vetenskaplig närbild</span>
          <span class="ph-type">Illustration</span>
        </div>
      {%- endif -%}
      <div>
        <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.body1 }}</p>
        <p>{{ section.settings.body2 }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mekanism",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "text", "id": "eyebrow", "label": "Etikett", "default": "Mekanismen" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "WTF är hypoklorsyra?" },
    { "type": "textarea", "id": "body1", "label": "Brödtext 1", "default": "Hypoklorsyra (HOCl) är ingen ny laboratorieuppfinning. Det är molekylen kroppens egna vita blodkroppar tillverkar för att lugna och skydda huden." },
    { "type": "textarea", "id": "body2", "label": "Brödtext 2", "default": "Vi har stabiliserat exakt samma molekyl i en flaska. Samma ämne huden redan känner igen, fast redo att användas precis när du behöver det." }
  ],
  "presets": [ { "name": "Mekanism" } ]
}
{% endschema %}
